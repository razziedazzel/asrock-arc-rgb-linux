<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>asrock-arc-rgb-linux</vendor>
  <vendor_url>https://github.com/razziedazzel/asrock-arc-rgb-linux</vendor_url>
  <action id="io.github.razziedazzel.arcrgb.service">
    <description>Turn the Arc RGB boot service on or off</description>
    <message>Authentication is required to change whether your RGB lighting is re-applied at boot</message>
    <icon_name>io.github.razziedazzel.ArcRGB</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBDIR@/arc_rgb.py</annotate>
  </action>
</policyconfig>
